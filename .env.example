# Browser-safe Supabase values
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Use the server secret supplied by Lovable. Current Supabase projects may call
# this SUPABASE_SECRET_KEY; legacy projects use SUPABASE_SERVICE_ROLE_KEY.
# Configure only one, and never prefix it with VITE_.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Application and transactional email
APP_ORIGIN=http://localhost:8080
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Stripe subscriptions (server-only unless prefixed VITE_)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Enable only after all Stripe values above are configured.
VITE_BILLING_ENABLED=false
