# Browser-safe Supabase values
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server secret for the Supabase admin client. Never prefix it with VITE_.
# On hosts that reserve the SUPABASE_ env var prefix for their own native
# integration (e.g. Vercel), set SB_SECRET_KEY instead -- it's checked first.
# Lovable/local environments can keep using SUPABASE_SECRET_KEY or the legacy
# SUPABASE_SERVICE_ROLE_KEY name. Configure only one.
SB_SECRET_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Application and transactional email
APP_ORIGIN=http://localhost:8080
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Stripe subscriptions (server-only unless prefixed VITE_)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Enable only after all Stripe values above are configured.
VITE_BILLING_ENABLED=false
