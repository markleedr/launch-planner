# Browser-safe Supabase values
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server secret for the Supabase admin client. Never prefix it with VITE_.
# On hosts that reserve the SUPABASE_ env var prefix for their own native
# integration (e.g. Vercel), set SB_SECRET_KEY instead -- it's checked first.
# Lovable/local environments can keep using SUPABASE_SECRET_KEY or the legacy
# SUPABASE_SERVICE_ROLE_KEY name. Configure only one.
SB_SECRET_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Application and transactional email
APP_ORIGIN=http://localhost:8080
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Stripe subscriptions (server-only unless prefixed VITE_)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Enable only after all Stripe values above are configured.
VITE_BILLING_ENABLED=false

# Google Maps Embed API key (browser-safe; restrict it to launchplanner.com.au).
# Without it the project summary shows a link to Google Maps instead of a map.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Meta Pixel / dataset ID (public, browser-safe). Falls back to the Launch Planner
# pixel when unset.
VITE_META_PIXEL_ID=974997054805397

# PostHog analytics (US cloud, public project key, browser-safe).
# Project Profile / Default project (id 486798). The app falls back to this key
# and https://us.i.posthog.com when these are unset. Never put a PostHog
# personal API key in a VITE_ variable.
VITE_POSTHOG_KEY=phc_BYvzegBkFAW5vtBxQqenAEqRiVeCoHtUmGNEd6GiUCvX
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server-only CRM webhook for Urban Developer email captures. Never prefix with VITE_.
# POST JSON to CRM_LEAD_WEBHOOK_URL with header x-launch-planner-secret: CRM_LEAD_WEBHOOK_SECRET.
# Example URL: https://cjthyjilyzuoxwgbtnip.supabase.co/functions/v1/launch-planner-lead
CRM_LEAD_WEBHOOK_URL=
CRM_LEAD_WEBHOOK_SECRET=
